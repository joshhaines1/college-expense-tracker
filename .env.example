# Copy to .env (cp .env.example .env && chmod 600 .env) and fill in. NEVER commit .env.

# --- Google OAuth (README step 3). Create a "Desktop app" OAuth client in Google Cloud Console. ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Printed by `npm run auth` (README step 4).
GOOGLE_REFRESH_TOKEN=

# --- Your spreadsheet: the long ID in https://docs.google.com/spreadsheets/d/<THIS_PART>/edit ---
SPREADSHEET_ID=
SHEET_NAME=
# Header row is 7, so transactions start at row 8.
FIRST_DATA_ROW=

# --- Printed by `npm run setup:folder` (README step 5). Must be a folder created by this app. ---
DRIVE_FOLDER_ID=

# --- Access control (optional but recommended) ---
# Only allow this Tailscale login (e.g. you@gmail.com) to use the API. Tailscale Serve sets the
# Tailscale-User-Login header; leave blank to rely on tailnet ACLs alone.
ALLOWED_TAILSCALE_LOGIN=

# --- Tuning (defaults are fine) ---
MAX_UPLOAD_MB=15
OCR_TIMEOUT_MS=60000
